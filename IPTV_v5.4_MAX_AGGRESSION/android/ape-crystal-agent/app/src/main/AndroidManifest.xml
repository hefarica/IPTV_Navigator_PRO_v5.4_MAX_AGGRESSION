<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Aplicador puro: NO lee logs (no READ_LOGS). Solo escribe Settings permitidos.
         Grantable por adb a una app sideloaded (protectionLevel ...|development):
           adb shell pm grant com.ape.crystalagent android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Self-update: instalar el APK descargado de /ara/agent.apk (consent 1x) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Fire TV no tiene pantalla táctil -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- ⚠ ICONO/BANNER: NO usar @android:drawable/* aqui.
         Estaba puesto android:icon="@android:drawable/ic_media_play" (y banner igual),
         que es un recurso del FRAMEWORK. Ese id (0x01080024) no resuelve en el
         framework del dispositivo, y PackageManager rechaza el paquete entero con
         "No se instaló la app porque parece que el paquete no es válido".
         Medido el 2026-11-07: los 19 APK del repo fallaban por esto (aapt rc=1,
         "ERROR getting 'android:icon' attribute"). Sin android:icon el sistema usa
         el icono por defecto y el APK instala en cualquier dispositivo.
         Si algun dia se quiere icono propio, anadir res/mipmap-*/ic_launcher y
         referenciar "@mipmap/ic_launcher" — NUNCA "@android:drawable/...". -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="APE Crystal Agent">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- F3: player propio (HEVC-first). exported para test por adb am start. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTask" />

        <!-- [2026-11-14] BADGE DE UPSCALING EN EL OVERLAY.
             Pedido textual del operador: "necesito que en el overlay, coloques un
             logo de upscaling para saber que esta funcionando".

             AISLADO A PROPOSITO: es una Activity nueva, no un cambio en
             MainActivity ni en el PlayerActivity. Si este badge causa cualquier
             problema en el televisor, se borra esta entrada del manifest y todo
             lo demas sigue exactamente igual.

             Sin icono propio (como JitLinkActivity): vive DENTRO de
             com.ape.crystalagent, no aparece como segunda app.

             exported="true" para poder dispararlo desde el PC sin navegar el
             menu del televisor. Los comandos van en el README del badge, no
             aqui: un comentario XML NO puede contener dos guiones seguidos, y
             escribirlos fue lo que rompio este manifest en el primer intento.
             En resumen: se lanza con am start sobre la clase, con extras
             opcionales "label" (texto) y "hide" (booleano) para esconderlo.

             noHistory + excludeFromRecents: la Activity no tiene UI propia (la
             ventana del badge vive en el WindowManager), asi que no debe quedar
             en el historial ni en recientes despues de finish(). -->
        <activity
            android:name=".UpscaleBadgeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 657: receptor de REPRODUCTOR EXTERNO (fusion REA).
             Es la actividad que aparece en el selector de Android cuando OTT
             Navigator o TiviMate hacen "Abrir en reproductor externo".
             Recibe ACTION_VIEW con la URL y las cabeceras, valida la peticion y
             la reenvia a .PlayerActivity (mismo paquete, sin salto de app).
             Sin este <intent-filter> la app NO aparece en ese selector y la
             ruta B del manual es inalcanzable. -->
        <!-- REA · Catalogo JIT: muestra las URLs confirmadas por el VPS y abre
             OTT. NO registra el proveedor en OTT (eso es alta de UI: Ajustes ->
             Proveedor -> Anadir proveedor). Llamarlo "importar automaticamente"
             seria mentir; por eso se llama "Abrir OTT". -->
        <!-- Pantalla DENTRO de APE Crystal Agent. SIN icono propio: un segundo
             LAUNCHER la haria parecer otra APK y el operador pidio expresamente
             que TODO viva dentro de com.ape.crystalagent. Se abre desde
             MainActivity (boton) o por Intent explicito. -->
        <activity
            android:name="com.ape.crystalagent.JitLinkActivity"
            android:exported="true"
            android:label="REA · Catalogo JIT"
            android:parentActivityName="com.ape.crystalagent.MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTop" />

        <activity
            android:name="com.ape.rea.ReaExternalPlayerActivity"
            android:exported="true"
            android:label="REA · Reproductor externo"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="application/x-mpegURL" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".AgentService"
            android:exported="false" />

        <activity
            android:name=".ScreenCaptureActivity"
            android:exported="true" />

        <activity
            android:name=".SseTestActivity"
            android:exported="true" />

        <service
            android:name=".ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <service
            android:name=".CaptureWatchdogService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name=".AraAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ara_accessibility" />
        </service>

        <receiver
            android:name=".ZapReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ape.crystalagent.ZAP" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A/B de imagen: toggle y captura PixelCopy vía adb broadcast. Solo test local. -->
        <receiver
            android:name=".AbTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ape.crystalagent.AB" />
            </intent-filter>
        </receiver>

        <!-- FileProvider para el self-update (SelfUpdateManager lanza el install del APK descargado) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- WireGuard GoBackend VpnService (full-tunnel embebido). El consent VPN lo pide VpnConsentActivity. -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
