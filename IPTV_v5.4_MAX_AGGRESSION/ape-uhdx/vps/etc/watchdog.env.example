# ═══════════════════════════════════════════════════════════════════
# APE UHDX — VPS watchdog config  →  copiar a /etc/ape-uhdx/watchdog.env
# ═══════════════════════════════════════════════════════════════════
# IP:puerto del ONN para ADB DESDE EL VPS (la direccion que ya usas tu).
ONN_ADDR="192.168.10.28:5555"

# Binarios / rutas
ADB_BIN="/usr/bin/adb"
DAEMON_LOCAL="/opt/ape-uhdx/onn/ape-uhdx-sentinel.sh"     # copia maestra en el VPS (se re-push si cambia)
DAEMON_REMOTE="/data/local/tmp/ape-uhdx-sentinel.sh"      # ruta en el ONN
REMOTE_LOCK="/data/local/tmp/ape-uhdx-sentinel.lock"

# Salida de estado que sirve Nginx
STATE_DIR="/var/www/ape-uhdx"

# Log + timeout ADB
LOG_FILE="/var/log/ape-uhdx-watchdog.log"
ADB_TIMEOUT="8"
