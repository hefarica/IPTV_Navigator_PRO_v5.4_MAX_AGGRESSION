# OMEGA ARA URL-2 — environment (Council-safe). Copy to ara.env and fill ARA_TOKEN.
# Production: ARA_TOKEN must be non-empty and long random (events-sse.php returns 503 if empty).
ARA_TOKEN=CHANGE_ME_LONG_RANDOM
ARA_ENDPOINT=https://iptv-ape.duckdns.org
APE_LAB_MODE=0
CONVIVA_DB_PATH=/opt/netshield/data/conviva.db
# Phase G PQ->SDR rollback delta emission. Disabled by default until cooldown validated.
APE_PQ_ROLLBACK_ENABLED=0
APE_PQ_ROLLBACK_INCIDENTS_MIN=2
APE_PQ_ROLLBACK_COOLDOWN_SECONDS=1800
