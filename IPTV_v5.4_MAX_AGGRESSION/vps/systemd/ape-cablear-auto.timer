[Unit]
# [2026-11-14] Timer del cableador automatico de listas.
#
# Cada 15 minutos mira si hay una lista nueva sin su version _CABLEADA y la
# genera. Idempotente: si ya existe y es mas nueva que la fuente, no hace nada.
#
# POR QUE TIMER Y NO `.path`:
#   Un `.path` con PathModified sobre /var/www/html/lists/ dispararia EN CUANTO
#   empieza la escritura de la lista, con el fichero a medias. El cableador
#   leeria 200 MB de 1,3 GB y produciria una lista truncada. El timer espera a
#   que el generador termine. Es menos inmediato y mucho mas seguro.
#
# [FIX 2026-11-14] OnUnitActiveSec NO se reprograma en este caso.
#   Con la version anterior (`OnBootSec=5min` + `OnUnitActiveSec=15min`) el
#   timer se disparo UNA vez a las 17:06:34 y quedo con:
#       NextElapseUSecMonotonic=infinity
#   Result=success, pero sin proxima ejecucion. El servicio es Type=oneshot con
#   SuccessExitStatus=0 3; tras la primera pasada el ciclo se queda sin ancla y
#   el timer no vuelve a programarse. Medido con systemctl list-timers:
#       NEXT  LEFT  LAST  PASSED  UNIT
#       -     -     17:06:34  54s ago  ape-cablear-auto.timer
#   Es decir: la ruta automatica habria funcionado exactamente UNA vez.
#
#   `OnCalendar` no depende del estado del servicio: es una expresion de reloj,
#   la evalues quien la evalue. Cada cuarto de hora en punto. Es el mecanismo
#   correcto para "esto tiene que pasar siempre, pase lo que pase con el unit".
Description=APE cablear automatico de listas (cada 15 min, OnCalendar)
Documentation=file:/opt/ape-pulse/ape-cablear-auto.sh

[Timer]
# Cada 15 minutos: :00, :15, :30, :45 de cada hora.
OnCalendar=*:0/15
# Si el VPS estaba apagado a la hora del tick, al volver corre una vez.
# (El cableador es idempotente, asi que recuperar un tick atrasado es inofensivo.)
Persistent=true
AccuracySec=1min
RandomizedDelaySec=30
Unit=ape-cablear-auto.service

[Install]
WantedBy=timers.target
