[Unit]
Description=APE SoC allowlist reconciler — allowlist SIEMPRE completa (esquema v2)
Documentation=repo:docs/rea/16_SOC_ALLOWLIST_RECONCILER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# User=root JUSTIFICADO: el script escribe /etc/ape-uhdx/ape_soc_allowlist.json
# (+ .bak y soc_needs_curation.txt). No hay forma de escribir /etc como no-root
# sin mover la allowlist a otra ruta, y la ruta la fija el consumidor del plano.
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/ape/prisma/tools/ape_soc_allowlist_reconciler.py --seen /var/lib/ape/soc_seen.jsonl --out /etc/ape-uhdx/ape_soc_allowlist.json --curation /etc/ape-uhdx/soc_needs_curation.txt --lock /etc/ape-uhdx/.ape_soc_allowlist.lock
# Opcional (si el deploy del seed está presente): añadir
#   --seed /opt/ape/prisma/etc/ape_soc_allowlist.seed.json
# Endurecimiento: el script no necesita nada más que leer /var/lib/ape y escribir /etc/ape-uhdx.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/etc/ape-uhdx /var/lib/ape
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
