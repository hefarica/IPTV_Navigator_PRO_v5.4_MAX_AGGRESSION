#!/usr/bin/env bash
# ape-canaryctl — control operador del canary 4K (FASE 1).
#
#   ape-canaryctl start <id> --from-list <playlist[.gz]> [--seconds N]
#   ape-canaryctl start <id> --source-url <url> [--seconds N]
#   ape-canaryctl status <id>
#   ape-canaryctl stop <id>
#   ape-canaryctl rollback <id>
#   ape-canaryctl logs <id>
#
# Aislamiento: sólo UN canal, salida /var/lib/ara/canary/<id>, sin tocar
# /lists/, /sync, /ara ni el catálogo global. Nunca imprime la URL del canal
# (puede contener el par cuenta/clave de R1).
set -euo pipefail

CMD="${1:-}"; ID="${2:-}"
ENV_DIR="/etc/ara/canary"
OUT_ROOT="/var/lib/ara/canary"
UNIT="ape-canary@${ID}.service"

usage(){ echo "uso: $0 {start|status|stop|rollback|logs} <id> [--from-list PATH|--source-url URL] [--seconds N]" >&2; exit 2; }
[ -n "$CMD" ] && [ -n "$ID" ] || usage
[[ "$ID" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || { echo "id inválido" >&2; exit 2; }

sanitize(){ sed -E 's#https?://[^[:space:]]+#<redacted-url>#g'; }

start(){
  local src="" list="" secs="${CANARY_SECONDS:-6}"
  shift 2 || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --from-list) list="${2:-}"; shift 2 ;;
      --source-url) src="${2:-}"; shift 2 ;;
      --seconds) secs="${2:-6}"; shift 2 ;;
      *) echo "arg desconocido: $1" >&2; exit 2 ;;
    esac
  done
  if [ -z "$src" ] && [ -n "$list" ]; then
    [ -r "$list" ] || { echo "lista no legible: $list" >&2; exit 3; }
    case "$list" in
      *.gz) src="$(zcat -- "$list" 2>/dev/null | grep -m1 -E '^https?://' || true)" ;;
      *)    src="$(grep -m1 -E '^https?://' "$list" 2>/dev/null || true)" ;;
    esac
    echo "source=lista:$(basename "$list") (URL redacted)"
  fi
  [ -n "$src" ] || { echo "sin source (usa --from-list o --source-url)" >&2; exit 3; }
  [[ "$src" =~ ^https?:// ]] || { echo "source no http(s)" >&2; exit 3; }

  /usr/local/bin/ara-skill check --for-canary >/dev/null || { echo "GATE_FAIL: ara-skill"; exit 78; }

  install -d -m 0750 -o root -g www-data "$ENV_DIR"
  install -d -m 0750 -o www-data -g www-data "$OUT_ROOT/$ID"
  umask 027
  {
    printf 'CANARY_SOURCE_URL=%s\n' "$src"
    printf 'CANARY_OUT_DIR=%s\n' "$OUT_ROOT/$ID"
    printf 'CANARY_SECONDS=%s\n' "$secs"
    printf 'CANARY_FPS=5\n'
  } > "$ENV_DIR/$ID.env"
  chown root:www-data "$ENV_DIR/$ID.env"
  chmod 0640 "$ENV_DIR/$ID.env"

  systemctl daemon-reload >/dev/null 2>&1 || true
  if systemctl start "$UNIT"; then
    echo "started $UNIT (source redacted, seconds=$secs, fps=5)"
  else
    echo "CANARY_FAIL: no arrancó $UNIT (ver 'ape-canaryctl logs $ID')" >&2
    exit 4
  fi
}

status(){
  local state out seg wh usage start_us now_us pct quota
  state="$(systemctl is-active "$UNIT" 2>/dev/null || true)"
  out="$OUT_ROOT/$ID"
  echo "unit=$UNIT state=${state:-unknown}"
  echo "quota=$(systemctl show -p CPUQuotaPerSecUSec --value "$UNIT" 2>/dev/null || true) memmax=$(systemctl show -p MemoryMax --value "$UNIT" 2>/dev/null || true)"
  usage="$(awk '/usage_usec/{print $2}' "/sys/fs/cgroup/system.slice/$UNIT/cpu.stat" 2>/dev/null || echo 0)"
  start_us="$(systemctl show -p ActiveEnterTimestampMonotonic --value "$UNIT" 2>/dev/null || echo 0)"
  now_us="$(awk '{printf "%d", $1*1000000}' /proc/uptime)"
  if [ "${start_us:-0}" -gt 0 ] && [ "$now_us" -gt "$start_us" ]; then
    pct="$(awk -v u="$usage" -v e="$((now_us-start_us))" 'BEGIN{printf "%.1f", (u*100.0)/e}')"
    echo "cpu_pct_avg=$pct (cgroup, % de un core; CPUQuota=40%)"
  else
    echo "cpu_pct_avg=0.0"
  fi
  if [ -d "$out" ]; then
    seg="$(ls -1t "$out"/*.ts 2>/dev/null | head -1 || true)"
    if [ -n "$seg" ]; then
      wh="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 "$seg" 2>/dev/null | head -1)"
      echo "segment=$(basename "$seg") resolution=${wh:-?}"
    else
      echo "segment=none"
    fi
  fi
}

stop(){
  systemctl stop "$UNIT" 2>/dev/null || true
  echo "stopped $UNIT"
}

rollback(){
  local envf="$ENV_DIR/$ID.env" src="" code=""
  if [ -r "$envf" ]; then
    src="$(sed -n 's/^CANARY_SOURCE_URL=//p' "$envf" | head -1)"
  fi
  systemctl stop "$UNIT" 2>/dev/null || true
  systemctl reset-failed "$UNIT" 2>/dev/null || true
  rm -rf "$OUT_ROOT/$ID"
  rm -f "$envf"
  if [ -n "$src" ]; then
    code="$(curl -s -o /dev/null -m 15 -w '%{http_code}' "$src" 2>/dev/null || true)"
    echo "rollback: canal origen HTTP ${code:-ERR} (URL redacted)"
    [ "$code" = "200" ] || { echo "ROLLBACK_SOURCE_FAIL" >&2; exit 5; }
  else
    echo "rollback: sin env previo (nada que verificar)"
  fi
  echo "rollback_clean=1 /lists untouched"
}

logs(){
  journalctl -u "$UNIT" -n 40 --no-pager 2>/dev/null | sanitize || true
}

case "$CMD" in
  start) start "$@" ;;
  status) status ;;
  stop) stop ;;
  rollback) rollback ;;
  logs) logs ;;
  *) usage ;;
esac
