#!/usr/bin/env bash
# ara-skill — gate de skills del VPS (FASE 0).
#
#   ara-skill check              corpus + binarios base
#   ara-skill check --for-canary corpus + ffmpeg/libx265/systemd y filtros
#   ara-skill status             resumen instalado
#
# Sale 0 sólo si TODO pasa. El canary lo usa como ExecStartPre y en
# ape-canaryctl start; si falla, no arranca.
set -euo pipefail

ROOT="${ARA_SKILL_ROOT:-/etc/ara/skills}"
JSON="$ROOT/skills.json"
MODE="check"
for arg in "$@"; do
  case "$arg" in
    check) MODE="check" ;;
    status) MODE="status" ;;
    list) MODE="list" ;;
    corpus) MODE="corpus" ;;
    show) MODE="show" ;;
    --for-canary) CANARY=1 ;;
    *) if [ "$MODE" = "show" ]; then SHOW_ID="$arg"; else echo "ara-skill: argumento desconocido: $arg" >&2; exit 2; fi ;;
  esac
done
CANARY="${CANARY:-0}"

fail() { echo "ARA-SKILL FAIL: $*" >&2; exit 1; }

[ -d "$ROOT" ] || fail "falta $ROOT"
[ -f "$JSON" ] || fail "falta $JSON"
[ -f "$ROOT/SKILLS.md" ] || fail "falta SKILLS.md"
command -v python3 >/dev/null 2>&1 || fail "falta python3 para validar skills.json"

# ── Subcomandos de consulta (no gate): list / show <id> / corpus ──────────────
if [ "$MODE" = "list" ] || [ "$MODE" = "show" ] || [ "$MODE" = "corpus" ]; then
  command -v sha256sum >/dev/null 2>&1 || fail "falta sha256sum"
  python3 - "$JSON" "$ROOT" "$MODE" "${SHOW_ID:-}" <<'PY'
import hashlib, json, os, sys
manifest = json.load(open(sys.argv[1], encoding='utf-8'))
root, mode, want = sys.argv[2], sys.argv[3], (sys.argv[4] if len(sys.argv) > 4 else '')
skills = manifest.get('skills') or []
def h(p):
    try:
        return hashlib.sha256(open(p, 'rb').read()).hexdigest()
    except OSError:
        return ''
if mode == 'list':
    print(f"{'ID':<20} {'OK':<3} {'SHA256':<12} PATH")
    for s in skills:
        p = os.path.join(root, s.get('path', ''))
        got = h(p)
        ok = 'si' if got and (not s.get('sha256') or got == s['sha256']) else 'NO'
        print(f"{s.get('id',''):<20} {ok:<3} {got[:12] or '-':<12} {s.get('path','')}")
    hw = manifest.get('hardware') or {}
    print(f"hardware: soc={hw.get('soc','?')} npu={hw.get('npu','?')} max_decode={hw.get('max_decode','?')}")
    sys.exit(0)
if mode == 'corpus':
    print('corpus:')
    for s in skills:
        if str(s.get('path', '')).startswith('corpus/'):
            p = os.path.join(root, s['path'])
            print(f"  {'OK ' if h(p) else 'FALTA'} {s['path']} {os.path.getsize(p) if os.path.isfile(p) else 0} B")
    sys.exit(0)
# show <id>
hit = [s for s in skills if s.get('id') == want]
if not hit:
    print(f"ara-skill: no existe la skill '{want}'", file=sys.stderr); sys.exit(2)
s = hit[0]
p = os.path.join(root, s['path'])
print(f"id: {s['id']}")
print(f"path: {s['path']}")
print(f"sha256_manifest: {s.get('sha256','-')}")
print(f"sha256_real: {h(p) or '-'}")
print('---')
print(open(p, encoding='utf-8', errors='replace').read() if os.path.isfile(p) else '(fichero ausente)')
PY
  exit $?
fi
command -v sha256sum >/dev/null 2>&1 || fail "falta sha256sum"

# 1 · JSON + corpus + hashes
python3 - "$JSON" "$ROOT" <<'PY'
import hashlib, json, os, sys
manifest = json.load(open(sys.argv[1], encoding='utf-8'))
root = sys.argv[2]
skills = manifest.get('skills') or []
if not skills:
    print('ARA-SKILL FAIL: skills.json sin skills', file=sys.stderr); sys.exit(1)
for item in skills:
    rel = item.get('path', '')
    path = os.path.join(root, rel)
    if not os.path.isfile(path):
        print(f'ARA-SKILL FAIL: falta {rel}', file=sys.stderr); sys.exit(1)
    want = item.get('sha256', '')
    got = hashlib.sha256(open(path, 'rb').read()).hexdigest()
    if want and got != want:
        print(f'ARA-SKILL FAIL: hash {rel} ({got[:12]} != {want[:12]})', file=sys.stderr); sys.exit(1)
print(f'corpus_ok={len(skills)}')
PY

# 2 · binarios base
command -v ffmpeg >/dev/null 2>&1 || fail "falta ffmpeg"
command -v ffprobe >/dev/null 2>&1 || fail "falta ffprobe"
ffmpeg -hide_banner -encoders 2>/dev/null | grep 'libx265' >/dev/null || fail "ffmpeg sin libx265"
if [ "$CANARY" = "1" ]; then
  command -v systemctl >/dev/null 2>&1 || fail "falta systemctl"
  for f in deblock smartblur scale noise unsharp eq format; do
    ffmpeg -hide_banner -filters 2>/dev/null | grep -E "[[:space:]]$f[[:space:]]" >/dev/null || fail "ffmpeg sin filtro $f"
  done
  # `dering` no existe en ffmpeg 6.1 Ubuntu; se sustituye por smartblur (declarado).
  ffmpeg -hide_banner -filters 2>/dev/null | grep -E '[[:space:]]dering[[:space:]]' >/dev/null || \
    echo "ARA-SKILL WARN: ffmpeg sin filtro dering; canary usa smartblur (sustituto declarado)" >&2
fi

if [ "$MODE" = "status" ]; then
  python3 - "$JSON" <<'PY'
import json, sys
m = json.load(open(sys.argv[1], encoding='utf-8'))
print(f"name={m.get('name')} version={m.get('version')} phase={m.get('phase')} skills={len(m.get('skills', []))}")
PY
fi
echo "ARA-SKILL CHECK PASS (mode=$MODE canary=$CANARY root=$ROOT)"
exit 0

