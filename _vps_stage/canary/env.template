# /etc/ara/canary/<id>.env — plantilla
#
# QUÉ ES
#   El fichero de entorno que el unit `ape-canary@<id>.service` carga con EnvironmentFile=.
#   Sin él, `ape-visual-emulate.sh` muere en la línea 29 con:
#       CANARY_FAIL: falta CANARY_SOURCE_URL
#   y no se produce ningún status.json. Es la pieza que falta para que el canary arranque.
#
# CÓMO SE USA
#   cp /etc/ara/canary/env.template /etc/ara/canary/<id>.env
#   (editar CANARY_SOURCE_URL con la URL real a medir)
#   chown root:www-data /etc/ara/canary/<id>.env
#   chmod 640 /etc/ara/canary/<id>.env
#   systemctl start ape-canary@<id>
#
# IDEMPOTENCIA
#   El <id> debe ser estable por canal: r<sha1(url)[0:16]>. Ese mismo id usa el endpoint
#   canary-resolve.php, así que un canal medido una vez no se vuelve a medir dentro del TTL.
#
# SEGURIDAD
#   Este fichero contiene la URL del canal, que en algunos proveedores lleva el par
#   cuenta/clave. Por eso: 640 root:www-data, nunca world-readable, y nunca imprimir su
#   contenido en logs ni en la salida del canary.

# ── OBLIGATORIO ─────────────────────────────────────────────────────────────────
# URL del canal a medir. Debe ser http(s), sin espacios (el script lo valida en L32/L34).
CANARY_SOURCE_URL=

# ── OPCIONALES (con su valor por defecto en el script) ──────────────────────────
# Segundos de captura. Por defecto 6.
CANARY_SECONDS=6

# Directorio de salida. Por defecto /var/lib/ara/canary/<id>.
# No cambiar salvo que se sepa lo que se hace: el endpoint lee status.json de esa ruta.
#CANARY_OUT_DIR=/var/lib/ara/canary/<id>

# FPS de muestreo. Por defecto 5.
CANARY_FPS=5

# Timeout global del script en segundos. Por defecto 300 (coincide con RuntimeMaxSec del unit).
CANARY_TIMEOUT=300

# ── NOTAS SOBRE LO QUE FALTA EN EL VPS (medido 2026-11-04) ──────────────────────
#
#   1. /etc/ara/canary/ está VACÍO — no hay env.common ni <id>.env.
#      Por eso el canary nunca ha corrido.
#
#   2. /var/lib/ara/canary/ está VACÍO — no hay status.json de ningún canal.
#
#   3. /var/log/ara/ NO EXISTE.
#
#   4. El unit `ape-canary@` está disabled, sin instancia.
#
#   5. ExecStartPre=/usr/local/bin/ara-skill check --for-canary debe devolver PASS.
#      Si falla, el unit ni siquiera llega a ejecutar el script (L38: CANARY_FAIL).
#
#   Antes de escribir el endpoint que consuma esto, el orden correcto es:
#       a) crear este .env
#       b) `ape-canaryctl start test --source-url <url> --seconds 6`
#       c) comprobar que /var/lib/ara/canary/test/status.json existe y tiene datos reales
#       d) SÓLO ENTONCES escribir el endpoint
#
#   Un intento anterior saltó del paso (a) al endpoint directamente. Resultado: 500 en
#   producción y revert completo. Ver docs/ops/CANARY_RESOLVE_ANALISIS_2026-11-04.md
