        "value": "NIVEL 3: BLOQUE POR CANAL  (#EXTINF + #EXTVLCOPT + #KODIPROP + #EXTHTTP + #EXT-X-STREAM-INF + URL)  -> N veces"
      },
      "#KODIPROP": {
        "cell": "A8",
        "value": "NIVEL 3: BLOQUE POR CANAL  (#EXTINF + #EXTVLCOPT + #KODIPROP + #EXTHTTP + #EXT-X-STREAM-INF + URL)  -> N veces"
      },
      "#EXT-X-STREAM-INF": {
        "cell": "A8",
        "value": "NIVEL 3: BLOQUE POR CANAL  (#EXTINF + #EXTVLCOPT + #KODIPROP + #EXTHTTP + #EXT-X-STREAM-INF + URL)  -> N veces"
      },
      "CMCD": {
