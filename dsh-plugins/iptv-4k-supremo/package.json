{
  "name": "@local/iptv-4k-supremo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catálogo medido de los 11 repos supremos IPTV 4K: declarado frente a medido, endpoints sondeados y la ruta real al 2160p.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "MEASURED_2026-11-15.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
