{
  "name": "@local/iptv-sr-rules",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reglas de superresolucion aplicadas a la generacion de listas IPTV (M3U/M3U8/JSON).",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
