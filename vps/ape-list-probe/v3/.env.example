# Copiar como .env. Iniciar: node --env-file=.env ape-list-probe.js
APE_PROBE_BIND=127.0.0.1
APE_PROBE_PORT=8787
# Colocar la URL de la lista para usar GET /probe sin parámetros.
APE_PROBE_LIST=
# Solo es obligatorio al escuchar fuera de loopback; mínimo 24 caracteres.
APE_PROBE_TOKEN=
# 3 GiB tanto para HTTP como para el contenido M3U descomprimido.
APE_MAX_BYTES=3221225472
APE_MAX_HTTP_BYTES=3221225472
APE_MAX_LINE_BYTES=1048576
APE_MAX_URL_BYTES=16384
APE_MAX_PATTERNS=128
APE_FETCH_TIMEOUT_MS=180000
APE_TOTAL_TIMEOUT_MS=240000
APE_IDLE_TIMEOUT_MS=15000
APE_DNS_TIMEOUT_MS=5000
APE_MAX_REDIRECTS=5
APE_SAMPLE_URLS=3
APE_SAMPLE_BUDGET=24
APE_SAMPLE_CONCURRENCY=4
APE_SAMPLE_TIMEOUT_MS=15000
APE_SAMPLE_BYTES=2048
APE_MAX_CONCURRENT=2
APE_RATE_PER_MIN=12
APE_MAX_RATE_IPS=2048
APE_CACHE_TTL_MS=900000
APE_CACHE_MAX_ENTRIES=16
APE_CACHE_MAX_FILE_BYTES=16777216
# Vacío: state/cache-v3.json junto al script. off: sin escritura en disco.
APE_PROBE_CACHE=
# Listas separadas por comas, nombres o IP exactos, sin comodines.
# Vacío: se permiten destinos públicos y se bloquean privados/reservados.
APE_ALLOWED_HOSTS=
# Excepciones privadas puntuales. Dejar vacío salvo necesidad real de red local.
APE_ALLOW_PRIVATE_HOSTS=
APE_SHUTDOWN_TIMEOUT_MS=10000
